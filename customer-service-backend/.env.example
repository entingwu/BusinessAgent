# 复制为 .env 并填入真实值。.env 已被 .gitignore 排除，切勿提交。

# LLM（示例为阿里云百炼 DashScope 的 OpenAI 兼容接口）
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-你的密钥

# 电商业务服务（本地 docker-compose 起的 ecommerce-service-backend）
COMMERCE_API_BASE_URL=http://127.0.0.1:18081

# 数据库
DATABASE_URL=mysql+aiomysql://用户名:密码@127.0.0.1:13306/数据库名?charset=utf8mb4

# 服务监听
APP_HOST=0.0.0.0
APP_PORT=18082
