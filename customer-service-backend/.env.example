# 复制为 .env 并填入真实值。.env 已被 .gitignore 排除，切勿提交。

# LLM（示例为阿里云百炼 DashScope 的 OpenAI 兼容接口）
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-你的密钥

# 电商业务服务（本地 docker-compose 起的 ecommerce-service-backend）
COMMERCE_API_BASE_URL=http://127.0.0.1:18081

# 数据库
DATABASE_URL=mysql+aiomysql://用户名:密码@127.0.0.1:13306/数据库名?charset=utf8mb4

# 服务监听
APP_HOST=0.0.0.0
APP_PORT=18082

# 应用日志级别（规范 5.3 可观测性）。有默认值 INFO，可以不配。
# 注意这只管 business_agent 这一棵；检索日志由下面的 KNOWLEDGE_LOG_LEVEL 单独控制，
# 两者互不影响——检索日志量大，需要能单独关掉
LOG_LEVEL=INFO

# 商家自定义的转人工关键词，逗号分隔（规范 3.3.4「命中配置关键词」）。
# 留空即不启用这条触发；「转人工」「人工客服」这类内置词不受此项影响
HANDOFF_KEYWORDS=

# Knowledge base / RAG (selection rationale: meta-business-agent.md appendix C.4)
# Embedding reuses LLM_API_KEY / LLM_BASE_URL above — no second credential needed.
# Backend: dashscope (hosted, dense only) | bge_m3 (local, dense + sparse).
# Hybrid retrieval needs sparse vectors, so the Milvus path requires bge_m3.
EMBEDDING_BACKEND=dashscope
# Inference device, bge_m3 only: cpu | mps | cuda.
# Measured on M1 Max — mps is 2x faster per query (0.148s vs 0.308s) but slower
# in batch (0.038s vs 0.022s per item): MPS has a fixed per-call overhead that
# batching cannot amortise. Use mps for queries, cpu for the ingest CLI.
EMBEDDING_DEVICE=cpu
# dashscope backend: text-embedding-v3   |   bge_m3 backend: BAAI/bge-m3
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10

# Chroma persistence directory (relative paths resolve against customer-service-backend/)
# Vector store backend: chroma (dense only, fallback) | milvus (dense + sparse hybrid)
VECTOR_BACKEND=chroma
# milvus backend only
MILVUS_URI=http://127.0.0.1:19530
VECTOR_STORE_DIR=knowledge_store/chroma
VECTOR_COLLECTION_NAME=business_knowledge

# Knowledge source documents
KNOWLEDGE_SOURCE_DIR=knowledge_source

# Retrieval parameters. Token counts are estimates — see knowledge/ingest/tokens.py
KNOWLEDGE_CHUNK_SIZE=600
KNOWLEDGE_CHUNK_OVERLAP=100
KNOWLEDGE_TOP_K=5
# Calibrated against knowledge_eval/calibration_set.jsonl, NOT the spec's 0.35.
# text-embedding-v3 cosine scores run high enough that 0.35 filters almost nothing.
# Changing the embedding model OR the chunking invalidates this value — recalibrate:
#   uv run python -m business_agent.knowledge.ingest calibrate
KNOWLEDGE_SCORE_THRESHOLD=0.58
KNOWLEDGE_CONTEXT_MAX_TOKENS=2000

# Retrieval traceability: log level, and whether to write the retrieval_traces table.
# The server's root logger sits at WARNING; the knowledge package attaches its own
# handler to the business_agent.knowledge logger and this key sets its level.
# Set it to WARNING to silence retrieval logging.
KNOWLEDGE_LOG_LEVEL=INFO
KNOWLEDGE_TRACE_ENABLED=true
