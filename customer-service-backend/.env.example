# 复制为 .env 并填入真实值。.env 已被 .gitignore 排除，切勿提交。

# LLM（示例为阿里云百炼 DashScope 的 OpenAI 兼容接口）
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-你的密钥

# 电商业务服务（本地 docker-compose 起的 ecommerce-service-backend）
COMMERCE_API_BASE_URL=http://127.0.0.1:18081

# 数据库
DATABASE_URL=mysql+aiomysql://用户名:密码@127.0.0.1:13306/数据库名?charset=utf8mb4

# 服务监听
APP_HOST=0.0.0.0
APP_PORT=18082

# 知识库 / RAG（选型依据 meta-business-agent.md 附录 C.4）
# Embedding 复用上面的 LLM_API_KEY / LLM_BASE_URL，不需要第二套凭据
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10

# Chroma 本地持久化目录（相对路径以 customer-service-backend 为基准）
VECTOR_STORE_DIR=knowledge_store/chroma
VECTOR_COLLECTION_NAME=business_knowledge

# 知识源文档目录
KNOWLEDGE_SOURCE_DIR=knowledge_source

# 检索参数（单位 token 为估算值，估算函数见 knowledge/ingest/tokens.py）
KNOWLEDGE_CHUNK_SIZE=600
KNOWLEDGE_CHUNK_OVERLAP=100
KNOWLEDGE_TOP_K=5
# 阈值已用 knowledge_eval/calibration_set.jsonl 校准（text-embedding-v3 的余弦分数整体偏高，
# 规范默认的 0.35 在本模型下几乎不过滤任何东西）。换 Embedding 模型必须重新校准：
#   uv run python -m business_agent.knowledge.ingest calibrate
KNOWLEDGE_SCORE_THRESHOLD=0.58
KNOWLEDGE_CONTEXT_MAX_TOKENS=2000

# 检索溯源：日志级别 + 是否落 retrieval_traces 表
# 服务进程的 root logger 停在 WARNING，knowledge 包自己给 business_agent.knowledge 挂 handler，
# 级别由这个键控制；设成 WARNING 可以关掉检索日志。
KNOWLEDGE_LOG_LEVEL=INFO
KNOWLEDGE_TRACE_ENABLED=true
